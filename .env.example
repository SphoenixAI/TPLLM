# ── TPLLM Configuration ─────────────────────────────────────
# Copy this file to .env and fill in the values you need.
# Only the LLM provider section is required — all integrations are optional.

# ── LLM Provider (required) ────────────────────────────────
# Choose "anthropic" or "openai" (the OpenAI-compatible API protocol).
# No provider or model is selected automatically. Offline commands need neither.
TPLLM_PROVIDER=
TPLLM_MODEL=

# Anthropic (only when TPLLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# OpenAI-compatible (if using DeepSeek, Gemini, Together, Ollama, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# ── Data Directory ─────────────────────────────────────────
# Where TPLLM stores program data (default: ./.tpllm)
# TPLLM_DATA_DIR=./.tpllm

# ── GitHub Integration ─────────────────────────────────────
# GITHUB_TOKEN=ghp_...

# ── Jira Integration ──────────────────────────────────────
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_API_TOKEN=
# JIRA_EMAIL=you@company.com

# ── Slack Integration ─────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...

# ── Linear Integration ────────────────────────────────────
# LINEAR_API_KEY=lin_api_...

# ── Google Chat Integration ───────────────────────────────
# GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...
# GCHAT_SERVICE_ACCOUNT_KEY=/path/to/service-account.json

# ── Calendar Integration ──────────────────────────────────
# Google Calendar (service account with domain-wide delegation)
# GOOGLE_CALENDAR_SERVICE_ACCOUNT=/path/to/calendar-service-account.json
# GOOGLE_CALENDAR_CALENDAR_ID=primary
# GOOGLE_CALENDAR_DELEGATE_EMAIL=you@company.com

# Microsoft Graph (app-only client credentials)
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TENANT_ID=

# ── Zoom Integration ──────────────────────────────────────
# Server-to-Server OAuth app (marketplace.zoom.us)
# ZOOM_ACCOUNT_ID=
# ZOOM_API_KEY=              # Client ID
# ZOOM_CLIENT_SECRET=

# ── Email Integration ─────────────────────────────────────
# SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@company.com
# SMTP_PASSWORD=

# SendGrid (alternative to SMTP)
# SENDGRID_API_KEY=SG....

# EMAIL_FROM=tpllm@company.com
# EMAIL_FROM_NAME=TPLLM Agent

# ── Voice / TTS Integration ──────────────────────────────
# Backends: chatterbox, piper, kokoro, elevenlabs, system
# VOICE_BACKEND=system
# ELEVENLABS_API_KEY=
# VOICE_ID=
# VOICE_SPEED=1.0

# ── Google Drive Integration ─────────────────────────────
# GOOGLE_DRIVE_SERVICE_ACCOUNT=/path/to/drive-service-account.json
# GOOGLE_DRIVE_FOLDER_ID=

# ── Notion Integration ────────────────────────────────────
# NOTION_API_KEY=ntn_...
# Bounded decision inference (server only; independently disabled by default).
TYPESAFE_ENABLED=false
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_MODE=off
# TYPESAFE_TIMEOUT_SECONDS=8
# TYPESAFE_MAX_ATTEMPTS=2
JEV_INCLUDE_SOURCE_EXCERPTS=false
# Optional server-owned JSON policy and governed calibration approvals.
JEV_POLICY_PATH=

# Phase 2 task evaluation: no automatic routing, no authority changes.
# Uses the existing TPLLM_PROVIDER / TPLLM_MODEL and server API credentials.
# OpenAI-compatible endpoints must support native strict JSON Schema.
INTELLIGENCE_EVAL_MODE=off
# INTELLIGENCE_EVAL_SAMPLE_RATE=0.1
INTELLIGENCE_EVAL_COHORTS=software.deployments
INTELLIGENCE_DECISION_TASKS=risk.present.v1,risk.family.v1,risk.severity.v1
INTELLIGENCE_REASONING_TASKS=reasoning.root_cause_analysis.v1
INTELLIGENCE_INCLUDE_EXCERPTS=false
# REASONING_TIMEOUT_SECONDS=10
# REASONING_MAX_ATTEMPTS=2
# REASONING_MAX_OUTPUT=2048
