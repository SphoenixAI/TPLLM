# ── LLTPM Configuration ─────────────────────────────────────
# Copy this file to .env and fill in the values you need.
# Only the LLM provider section is required — all integrations are optional.

# ── LLM Provider (required) ────────────────────────────────
# Choose "anthropic" for Claude or "openai" for OpenAI-compatible APIs
LLTPM_PROVIDER=anthropic
LLTPM_MODEL=claude-sonnet-4-6

# Anthropic (if using Claude)
ANTHROPIC_API_KEY=

# OpenAI-compatible (if using DeepSeek, Gemini, Together, Ollama, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# ── Data Directory ─────────────────────────────────────────
# Where LLTPM stores program data (default: ./.lltpm)
# LLTPM_DATA_DIR=./.lltpm

# ── GitHub Integration ─────────────────────────────────────
# GITHUB_TOKEN=ghp_...

# ── Jira Integration ──────────────────────────────────────
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_API_TOKEN=
# JIRA_EMAIL=you@company.com

# ── Slack Integration ─────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...

# ── Linear Integration ────────────────────────────────────
# LINEAR_API_KEY=lin_api_...

# ── Google Chat Integration ───────────────────────────────
# GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...
# GCHAT_SERVICE_ACCOUNT_KEY=/path/to/service-account.json

# ── Calendar Integration ──────────────────────────────────
# Google Calendar (service account with domain-wide delegation)
# GOOGLE_CALENDAR_SERVICE_ACCOUNT=/path/to/calendar-service-account.json
# GOOGLE_CALENDAR_CALENDAR_ID=primary
# GOOGLE_CALENDAR_DELEGATE_EMAIL=you@company.com

# Microsoft Graph (app-only client credentials)
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TENANT_ID=

# ── Zoom Integration ──────────────────────────────────────
# Server-to-Server OAuth app (marketplace.zoom.us)
# ZOOM_ACCOUNT_ID=
# ZOOM_API_KEY=              # Client ID
# ZOOM_CLIENT_SECRET=

# ── Email Integration ─────────────────────────────────────
# SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@company.com
# SMTP_PASSWORD=

# SendGrid (alternative to SMTP)
# SENDGRID_API_KEY=SG....

# EMAIL_FROM=lltpm@company.com
# EMAIL_FROM_NAME=LLTPM Agent

# ── Voice / TTS Integration ──────────────────────────────
# Backends: chatterbox, piper, kokoro, elevenlabs, system
# VOICE_BACKEND=system
# ELEVENLABS_API_KEY=
# VOICE_ID=
# VOICE_SPEED=1.0

# ── Google Drive Integration ─────────────────────────────
# GOOGLE_DRIVE_SERVICE_ACCOUNT=/path/to/drive-service-account.json
# GOOGLE_DRIVE_FOLDER_ID=

# ── Notion Integration ────────────────────────────────────
# NOTION_API_KEY=ntn_...
